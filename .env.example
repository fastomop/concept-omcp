# concept-omcp — local configuration template. Copy to `.env` (gitignored) and edit
# the values you care about; everything has a sensible default.
#
#   cp .env.example .env
#
# pydantic-settings loads `.env` from the working directory on import. Prefix: CONCEPT_OMCP_

# --- Artifacts (built once via `concept-omcp build --omop`; loaded at startup) ---
# Default: the platform user-cache dir (e.g. ~/Library/Caches/concept-omcp on macOS,
# ~/.cache/concept-omcp on Linux). Override to point `serve` at artifacts elsewhere.
# CONCEPT_OMCP_ARTIFACT_DIR=/data/concept-omcp/artifacts

# --- Embedding (query encoder; MUST match the model the artifacts were built with) ---
# CONCEPT_OMCP_EMBEDDING_MODEL=abhinand/MedEmbed-large-v0.1
# CONCEPT_OMCP_EMBEDDING_DIM=1024

# --- ANN search ---
# CONCEPT_OMCP_OVERFETCH_MIN=100        # candidate floor before dedup/domain-filter

# --- MCP server transport ---
# stdio (default) speaks JSON-RPC over stdin/stdout — no host/port. Switch to
# streamable-http (e.g. in the container) to serve over a network; then host/port apply.
# CONCEPT_OMCP_TRANSPORT=streamable-http
# CONCEPT_OMCP_HOST=0.0.0.0
# CONCEPT_OMCP_PORT=8100

# --- Logging (concept_omcp.logging; always written to STDERR, never stdout) ---
# CONCEPT_OMCP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL
# CONCEPT_OMCP_LOG_FORMAT=detailed      # simple | detailed | json
# CONCEPT_OMCP_LOG_FILE=logs/concept-omcp.log   # optional: also write to a file
