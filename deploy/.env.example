# concept-omcp — container/compose configuration template.
#
# Copy to `deploy/.env` (gitignored) or export these before `docker compose up`.
# For running concept-omcp directly (not in a container) use the repo-root
# .env.example instead — it documents the full CONCEPT_OMCP_* settings surface.

# Host port to publish the Streamable HTTP MCP endpoint on (container always uses 8100).
CONCEPT_OMCP_PORT=8100

# Absolute path on the HOST to the artifacts built with `concept-omcp build --omop`.
# Mounted read-only into the container at /artifacts. The server fails fast if empty.
CONCEPT_OMCP_ARTIFACT_DIR=./artifacts

# Logging (written to stderr / container logs).
CONCEPT_OMCP_LOG_LEVEL=INFO
CONCEPT_OMCP_LOG_FORMAT=json
